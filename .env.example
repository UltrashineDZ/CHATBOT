# ─────────────────────────────────────────────
#  Copy this file to .env and fill in the values
#  Do NOT commit .env to GitHub!
# ─────────────────────────────────────────────

# From: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# From: Facebook Developer App → Messenger → Page Access Token
PAGE_ACCESS_TOKEN=your_facebook_page_token_here

# You choose this — any secret word (e.g. mysecretbot123)
# Must match exactly what you enter in Facebook webhook settings
VERIFY_TOKEN=mysecretbot123
